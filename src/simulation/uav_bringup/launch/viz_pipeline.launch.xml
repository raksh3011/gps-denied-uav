<!--
  Visual demo of the current stack, no Gazebo/PX4 needed:
  the mock pipeline with the REAL planner, plus viz_bridge (converts our
  custom messages to RViz types) and RViz2 itself.

  What you should see:
  - Axes marker (the vehicle) flying MockLocalization's slow circle
  - Gray trail: where it has been
  - Green sphere: the mission goal (MockMission)
  - Red sphere: MockWorldModel's obstacle
  - Green line: real_planner's live trajectory from the moving vehicle to
    the goal — watch it re-plan every tick and bend around the obstacle
    whenever the direct line crosses it (Theta* + D* Lite + Margasoochi at work)

  Swap mock_world_model for real_world_model (see
  real_perception_planning_pipeline.launch.xml) once a point cloud source
  is available — the OccupiedVoxels display then shows the live map too.
-->
<launch>
  <node pkg="uav_localization" exec="mock_localization" name="mock_localization" output="screen" />
  <node pkg="uav_world_model" exec="mock_world_model" name="mock_world_model" output="screen" />
  <node pkg="uav_mission" exec="mock_mission" name="mock_mission" output="screen" />
  <node pkg="uav_planning" exec="real_planner" name="real_planner" output="screen" />
  <node pkg="uav_safety" exec="mock_safety" name="mock_safety" output="screen" />
  <node pkg="uav_vehicle" exec="mock_vehicle" name="mock_vehicle" output="screen" />
  <node pkg="uav_bringup" exec="viz_bridge" name="viz_bridge" output="screen" />
  <node pkg="rviz2" exec="rviz2" name="rviz2"
        args="-d $(find-pkg-share uav_bringup)/config/viz.rviz" output="screen" />
</launch>
