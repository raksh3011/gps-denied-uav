<!--
  Same pipeline as mock_pipeline.launch.xml, except Safety is real:
  the SafetyMonitor state machine (staleness/validity gating, an
  independent obstacle-clearance check, sustained-loss escalation to
  MODE_LAND — see docs/SAFETY.md), instead of MockSafety. Everything else
  — Localization, World Model, Mission, Planning, Vehicle — is still
  mocked. See the "swap one module for real, keep the rest mocked"
  workflow in docs/DEVELOPMENT.md.

  No simulation prerequisites: real_safety only depends on ROS topics
  every other module here already mocks — no Gazebo/PX4 needed.
-->
<launch>
  <node pkg="uav_localization" exec="mock_localization" name="mock_localization" output="screen" />
  <node pkg="uav_world_model" exec="mock_world_model" name="mock_world_model" output="screen" />
  <node pkg="uav_mission" exec="mock_mission" name="mock_mission" output="screen" />
  <node pkg="uav_planning" exec="mock_planner" name="mock_planner" output="screen" />
  <node pkg="uav_safety" exec="real_safety" name="real_safety" output="screen" />
  <node pkg="uav_vehicle" exec="mock_vehicle" name="mock_vehicle" output="screen" />
</launch>
