<!--
  Real Localization: LiDAR/IMU -> FAST-LIO2 -> lio_state_bridge -> LocalizationState.

  Requires the vendored LIO backend to be present (see ../../../../uav_localization.repos
  and docs/LOCALIZATION.md — `vcs import src < uav_localization.repos` then
  `colcon build`). This launch file assumes the backend package is named
  `fast_lio` and exposes a `mapping.launch.py` accepting a `config_file`
  argument, matching the common ROS 2 ports of FAST-LIO2 as of Jazzy. If your
  vendored fork differs, adjust the <include> below and note the change in
  docs/LOCALIZATION.md. (FAST-LIO2's own launch file is upstream Python we
  don't control — <include> works with it regardless of which language it's
  written in, so it doesn't pull Python into anything we own.)

  Static transforms for lidar_link/imu_link -> base_link below must match
  simulation/models/x500_lidar/model.sdf and
  uav_localization/config/fast_lio_x500.yaml's extrinsic_T/extrinsic_R —
  see the comment in that yaml file if the sensor mount ever changes.
-->
<launch>
  <node pkg="tf2_ros" exec="static_transform_publisher" name="lidar_link_tf" output="screen"
        args="0.05 0 0.10 0 0 0 base_link lidar_link" />

  <node pkg="tf2_ros" exec="static_transform_publisher" name="imu_link_tf" output="screen"
        args="0 0 0 0 0 0 base_link imu_link" />

  <include file="$(find-pkg-share fast_lio)/launch/mapping.launch.py">
    <arg name="config_file" value="$(find-pkg-share uav_localization)/config/fast_lio_x500.yaml" />
  </include>

  <node pkg="uav_localization" exec="lio_state_bridge" name="lio_state_bridge" output="screen">
    <param name="odometry_topic" value="/Odometry" />
    <param name="map_frame" value="map" />
    <param name="staleness_timeout_s" value="0.3" />
    <param name="lost_timeout_s" value="1.5" />
    <param name="publish_rate_hz" value="100.0" />
  </node>
</launch>
