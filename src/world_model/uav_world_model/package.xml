<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>uav_world_model</name>
  <version>0.1.0</version>
  <description>World Model / Perception module (Person 2 owns). MockWorldModel for pipeline bring-up, plus the real VoxelMapper/ObstacleTracker-backed real_world_model (see docs/WORLD_MODEL.md).</description>
  <maintainer email="team@example.com">Person 2</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>uav_interfaces</depend>
  <depend>eigen</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
