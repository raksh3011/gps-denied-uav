<?xml version="1.0"?>
<model>
  <name>x500_lidar</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>UAV Team</name>
    <email>team@example.com</email>
  </author>
  <description>
    PX4 SITL x500 quadrotor with a 3D LiDAR + IMU attached to base_link, for
    GPS-denied Localization development. Install into
    PX4-Autopilot/Tools/simulation/gz/models/x500_lidar/ (or add this repo's
    simulation/models/ to GZ_SIM_RESOURCE_PATH) and launch PX4 SITL with
    PX4_GZ_MODEL=x500_lidar. See docs/LOCALIZATION.md.
  </description>
</model>
